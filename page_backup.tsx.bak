              <button onClick={() => setShowYearModal(false)} className="px-6 py-2.5 font-bold text-white bg-[#155EEF] hover:bg-blue-700 rounded-full transition-colors shadow-sm cursor-pointer">áž”áž„áŸ’áž€áž¾áž</button>
