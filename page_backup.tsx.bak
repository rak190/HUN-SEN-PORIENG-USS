                        <input type="number" defaultValue={subject.g9} className="w-12 px-1 py-1 text-center text-sm font-black text-teal-800 bg-white border border-teal-200 rounded-md focus:ring-2 focus:ring-teal-500 outline-none shadow-xs transition-shadow" />
                      </td>
                      <td className="px-2 py-2.5 text-center bg-indigo-50/10 group-hover:bg-indigo-50/30 transition-colors">
