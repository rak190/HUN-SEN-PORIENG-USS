                </div>
              </div>
            </div>
            <div className="p-6 bg-slate-50 border-t border-slate-100 flex gap-3 justify-end">
              <button type="button" onClick={() => setShowClassModal(false)} className="px-6 py-2.5 font-bold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-full transition-colors shadow-xs cursor-pointer">áž”áŸ„áŸ‡áž”áž„áŸ‹</button>
              <button type="submit" disabled={isAddingClass} className="px-6 py-2.5 font-bold text-white bg-[#155EEF] hover:bg-blue-700 rounded-full transition-colors shadow-sm cursor-pointer disabled:opacity-50">
