                      </td>
                      <td className="px-2 py-2.5 text-center bg-blue-50/10 group-hover:bg-blue-50/30 transition-colors">
                        <input type="number" defaultValue={subject.sci} className="w-12 px-1 py-1 text-center text-sm font-black text-blue-800 bg-white border border-blue-200 rounded-md focus:ring-2 focus:ring-blue-500 outline-none shadow-xs transition-shadow" />
                      </td>
                      <td className="px-2 py-2.5 text-center bg-amber-50/10 group-hover:bg-amber-50/30 transition-colors">
                        <input type="number" defaultValue={subject.soc} className="w-12 px-1 py-1 text-center text-sm font-black text-amber-800 bg-white border border-amber-200 rounded-md focus:ring-2 focus:ring-amber-500 outline-none shadow-xs transition-shadow" />
                      </td>
                    </tr>
                  ))}
