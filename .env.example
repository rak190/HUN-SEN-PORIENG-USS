# HUN-SEN-PORIENG-USS Environment Configuration Template
# Duplicate this file to .env.local for local development.
# In CI pipelines, use these non-secret placeholders to run typechecks and tests.

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.placeholder-service-role-key

# --- Telegram Bot Notifications (Optional) ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-token

# --- Cloudflare R2 / S3 Object Storage (Optional for document backups) ---
CLOUDFLARE_R2_ACCESS_KEY_ID=placeholder-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=placeholder-r2-secret-access-key
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=hunsenporieng-documents

# --- Optional Local Development Flags ---
ENABLE_LOCAL_POSTGREST_PROXY=false
